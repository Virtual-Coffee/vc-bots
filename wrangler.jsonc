{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vc-bots",
  "main": "src/index.ts",
  // Pinned past date for stable runtime behavior. Bump deliberately, not casually.
  "compatibility_date": "2026-01-01",

  // Co-working room state. One DO instance per Zoom meeting ID (addressed via getByName).
  "durable_objects": {
    "bindings": [{ "name": "COWORKING_ROOM", "class_name": "CoworkingRoom" }]
  },
  // SQLite-backed DO storage (GA, included on the Workers free plan).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CoworkingRoom"] }],

  // Event reminders. Cron triggers fire in UTC — translate intended local send-times.
  // DISABLED until the reminders feature is fleshed out (real CMS query/endpoint, real
  // channel, real send-times). Re-enable by restoring the entries below AND keeping them
  // byte-identical to CRON_TO_KIND in src/bots/reminders/index.ts. The empty array is
  // deliberate — deploying with it removes any crons already registered on Cloudflare,
  // whereas dropping the key entirely would leave them running.
  // "0 * * * *"    — hourly  (placeholder)
  // "0 13 * * *"   — daily   (placeholder UTC time)
  // "0 13 * * MON" — weekly  (placeholder UTC time)
  "triggers": { "crons": [] },

  "observability": { "enabled": true },

  // Non-secret config (single room). Secrets go via `wrangler secret put` / `.dev.vars`.
  "vars": {

    "ZOOM_MEETING_ID": "82832550878",
    // Netlify rewrites virtualcoffee.io/bots/* to this Worker (stripping the /bots prefix);
    // used only for the user-facing join link. Empty/unset falls back to the request origin.
    "PUBLIC_BASE_URL": "https://virtualcoffee.io/bots",
    "SLACK_COWORKING_CHANNEL_ID": "C0B6C3BFEDD",
    "ROOM_TITLE": "Co-Working Room",
    // Community maintainers @-mentioned at the end of the welcome message / App Home.
    "WELCOME_MAINTAINER_IDS": "U014HT3RNCU,U0157K5MUPJ,U01577R42TS,U01B9NQF2PR",
    // Event reminders (Phase 3). Hourly → events; daily/weekly → announcements (later);
    // event-admin mirrors the hourly with extra info like the Zoom host key (later).
    "SLACK_EVENTS_CHANNEL_ID": "C017WAKN883",
    "SLACK_ANNOUNCEMENTS_CHANNEL_ID": "C014AAPC09K",
    "SLACK_EVENTADMIN_CHANNEL_ID": "C0360K84NEQ",
    "CMS_GRAPHQL_URL": "https://virtualcoffee.io/graphql", // TODO: confirm CMS GraphQL endpoint
    "LOG_LEVEL": "info" // debug | info | warn | error (set LOG_LEVEL=debug in .dev.vars locally)
    // TODO(config): port remaining message/notice strings from the old rooms config.
  }
}
