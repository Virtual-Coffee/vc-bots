{
  "name": "vc-bots",
  "version": "1.0.0",
  "description": "VirtualCoffee Slack/Zoom bots — a single Cloudflare Worker (co-working room, welcome, App Home, event reminders).",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "fix-calendar": "node scripts/fix-calendar.ts",
    "gen:api-types": "node scripts/gen-api-types.ts",
    "specs:update": "node scripts/update-specs.ts && pnpm gen:api-types",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip"
  },
  "keywords": [],
  "author": "Joe Karow",
  "maintainers": [
    {
      "name": "VirtualCoffee Team",
      "email": "hello@virtualcoffee.io",
      "url": "https://virtualcoffee.io/"
    }
  ],
  "license": "ISC",
  "dependencies": {
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "jose": "^6.2.12",
    "luxon": "^3.7.2",
    "openapi-fetch": "^0.17.0",
    "slack-cloudflare-workers": "^1.3.10",
    "slackify-markdown": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@redocly/openapi-core": "^1.34.20",
    "@types/luxon": "^3.7.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.37.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.1"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
