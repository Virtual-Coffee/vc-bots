{
  "name": "vc-bots",
  "version": "1.0.0",
  "description": "VirtualCoffee Slack/Zoom bots — a single Cloudflare Worker (co-working room, welcome, App Home, event reminders).",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "gen:api-types": "node scripts/gen-api-types.ts",
    "specs:update": "node scripts/update-specs.ts && pnpm gen:api-types",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip"
  },
  "keywords": [],
  "author": "Joe Karow",
  "maintainers": [
    {
      "name": "VirtualCoffee Team",
      "email": "hello@virtualcoffee.io",
      "url": "https://virtualcoffee.io/"
    }
  ],
  "license": "ISC",
  "dependencies": {
    "jose": "^6.2.12",
    "luxon": "^3.7.2",
    "openapi-fetch": "^0.17.0",
    "slack-cloudflare-workers": "^1.3.10",
    "slackify-markdown": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@redocly/openapi-core": "^1.34.20",
    "@types/luxon": "^3.7.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.39.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
