{
  "name": "vc-bots",
  "version": "1.0.0",
  "description": "VirtualCoffee Slack/Zoom bots — a single Cloudflare Worker (co-working room, welcome, App Home, event reminders).",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "gen:api-types": "node scripts/gen-api-types.ts",
    "specs:update": "node scripts/update-specs.ts && pnpm gen:api-types",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip"
  },
  "keywords": [],
  "author": "Joe Karow",
  "maintainers": [
    {
      "name": "VirtualCoffee Team",
      "email": "hello@virtualcoffee.io",
      "url": "https://virtualcoffee.io/"
    }
  ],
  "license": "ISC",
  "dependencies": {
    "jose": "^6.2.13",
    "luxon": "^3.7.2",
    "openapi-fetch": "^0.17.0",
    "slack-cloudflare-workers": "^1.3.10",
    "slackify-markdown": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@eslint/js": "^10.0.1",
    "@redocly/openapi-core": "^1.34.22",
    "@types/luxon": "^3.7.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.43.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12",
    "wrangler": "^4.155.0"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
