{
  "name": "vc-bots",
  "version": "1.0.0",
  "description": "VirtualCoffee Slack/Zoom bots — a single Cloudflare Worker (co-working room, welcome, App Home, event reminders).",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "gen:api-types": "node scripts/gen-api-types.ts",
    "specs:update": "node scripts/update-specs.ts && pnpm gen:api-types",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip"
  },
  "keywords": [],
  "author": "Joe Karow",
  "maintainers": [
    {
      "name": "VirtualCoffee Team",
      "email": "hello@virtualcoffee.io",
      "url": "https://virtualcoffee.io/"
    }
  ],
  "license": "ISC",
  "dependencies": {
    "jose": "^6.2.12",
    "luxon": "^3.7.2",
    "openapi-fetch": "^0.17.0",
    "slack-cloudflare-workers": "^1.3.10",
    "slackify-markdown": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@eslint/js": "^10.0.1",
    "@redocly/openapi-core": "^1.34.21",
    "@types/luxon": "^3.7.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.41.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.1"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
